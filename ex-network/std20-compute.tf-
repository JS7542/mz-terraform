# ===================================================================
# 키 페어 생성
# ===================================================================
resource "aws_key_pair" "std20_terra_keypair" {
    key_name   = "std20-terra-keypair"
    public_key = file("~/.ssh/id_rsa.pub")  # 공개키 파일 경로

    tags = {
        Name = "${local.tag_header}terra-keypair"
    }

}


