# variable "변수명" {
#     description = "설명"
#     type        = string | number | bool
#     default     = "기본값"
# }

# output의 출력명의 a-z 순서대로 output 블록이 실행된다.

# output "출력명" {
#     description = "출력 설명"
#     value = "출력값"
# }

variable "region" {
    description = "AWS region"
    type        = string
    default     = "ap-east-1"
}

# list(Type) - 리스트 타입(중복 가능한 여러 데이터를 담을 수 있는) 변수 선언 예시
# variable "example_list" {
#     description = "Example list variable"
#     type        = list(string)
#     default     = ["value1", "value2"]
# }

# variable "subnet_cidr" {
#     description = "Subnet CIDR block"
#     type        = list(string)
#     default     = ["10.0.1.0/24",
#                    "10.0.2.0/24",
#                    "10.0.3.0/24"
#     ]
# }

# 이중 list(2차원 배열)
variable "subnet_cidr" {
    description = "Subnet CIDR block"
    type        = list(list(string))
    default     = [
        ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"],
        ["10.0.11.0/24", "10.0.12.0/24", "10.0.13.0/24"]
    ]
}

# set(Type) - 집합 타입(중복 불가능한 여러 데이터를 담을 수 있는) 변수 선언 예시
# variable "subnet_cidr" {
#     description = "Subnet CIDR block"
#     type        = set(string)
#     default     = ["10.0.1.0/24",
#                    "10.0.2.0/24",
#                    "10.0.1.0/24"
#     ]
# }

# variable "subnet_cidr" {
#     description = "Subnet CIDR block"
#     type        = set(string)
#     default     = ["10.0.1.0/24",
#                    "10.0.2.0/24",
#                    "10.0.1.0/24"
#     ]
# }

# map(Type) - 맵 타입(키-값 쌍으로 데이터를 담을 수 있는) 변수 선언 예시
# variable "example_map" {
#     description = "Example map variable"
#     type        = map(string)
#     default     = {
#         key1 = "value1"
#         key2 = "value2"
#     }
# }

variable "tags" {
    description = "A map of tags to assign to resources"
    type        = map(string)
    default     = {
        Name = "std20-Terraform"
        Environment = "Dev"
    }
}

# list(map(Type)) - 리스트 안에 맵 타입(키-값 쌍으로 데이터를 담을 수 있는) 변수 선언 예시
# variable "example_list_of_maps" {
#     description = "Example list of maps variable"
#     type        = list(map(string))
#     default     = [
#         {
#             key1 = "value1"
#             key2 = "value2"
#         },
#         {
#             key3 = "value3"
#             key4 = "value4"
#         }
#     ]
# }

variable "subnet_info" {
    description = "Information about subnets"
    type        = list(map(string))
    default     = [
        {
            name: "pub-subnet-1"
            cidr: "10.0.1.0/24"
        },
        {   
            name: "pub-subnet-2"
            cidr: "10.0.2.0/24"
        }
    ]
}
# ===================================================
# 구조체 : Tuple(튜플) / Object(객체)
# Tuple
# - 데이터 유형을 순서대로 정의
# - 데이터 유형 순서대로 데이터를 정의
variable "tup" {
    description = "A tuple variable example"
    type        = tuple([string, number, number, number])
    default     = ["홍길동", 100, 90, 80]
}

# Object
# - 키와 값의 데이터 유형을 정의
# - 각 키에 맞는 값을 정의
# 권장 사항 : default 선언을 하나 이상 할 것.
# 단점 : 개별 키에 접근할 때마다 전체 객체를 참조해야 함.
# variable "obj" {
#     description = "An object variable example"
#     type        = object({
#         vpc_id = string
#         vpc_cidr = string
#         tags = map(string)
#     })
#     default     =   {
#         vpc_id = ""
#         vpc_cidr = ""
#         tags = {}
#     } 
# }


variable "obj" {
    description = "An object variable example"
    type        = object({
        vpc_id = optional(string,"")
        vpc_cidr = optional(string,"")
    })
    default     =   {
        vpc_id = ""
    } 
}
